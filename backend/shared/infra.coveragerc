# Coverage config for the shared-infra CI job (combine-shared-infra in ci.yml),
# which gates every package under backend/shared/ that has a test suite at the
# repo's 90% line-coverage floor (see CLAUDE.md). Exceptions: shared.postgres,
# shared.neo4j and shared.cache carry their own gated jobs (they need live
# service containers) and stay out of this one.
#
# The gate never runs tests itself. Two upstream jobs record shared coverage
# into per-suite data-file artifacts; combine-shared-infra downloads them,
# `coverage combine`s, and reports against this config:
#
#   * test-backend's software_engineering matrix entry — the neutral packages
#     extracted from software_engineering_team (command_runner, repo_context,
#     llm_recovery, dev_models, git, hitl, run_thread_registry), which the SE
#     suite exercises rather than tests of their own.
#   * test-shared-packages — every shared package whose tests live under
#     backend/shared/<pkg>/tests/, plus the loose modules covered by
#     backend/shared/tests/.

# Cross-runner path normalization for `coverage combine`. The SE, coding_team,
# and combine jobs all checkout to the same absolute prefix today, so combine
# already merges cleanly; this is a defensive net so a future runner-path change
# (self-hosted, different checkout dir) still unifies the data files onto the
# tree present in the combine job. Keep absolute (default) paths — do NOT set
# relative_files, which would change how the git_utils.py omit below matches.
[paths]
source =
    ${GITHUB_WORKSPACE}/backend/agents
    */backend/agents

[report]
show_missing = true
# omit lives under [report], NOT [run]: this config is applied only at REPORT
# time (combine-shared-infra never measures), and `coverage report` honors
# [report] omit but ignores [run] omit. Patterns match the absolute paths stored
# in the combined data, so each needs a `*/` prefix.
omit =
    */tests/*
    */__pycache__/*
    # Integration-heavy git subprocess layer: excluded from the unit gate for the
    # same reason software_engineering_team/pyproject.toml omitted
    # shared/git_utils.py before the extraction — its branch/merge/recovery paths
    # drive live git worktrees and are exercised by integration tests, not unit
    # tests. branch_utils (pure helpers) remains gated.
    */shared/git/git_utils.py
    # Test-only scaffolding: a shared WorkflowEnvironment bootstrap imported
    # solely from test files (see its module docstring), kept outside a tests/
    # directory only so several suites can share one copy. Excluded on the same
    # grounds as */tests/* above — shared.temporal clears the 90% floor either
    # way, so this is a correctness cleanup, not a threshold concession.
    */shared/temporal/testing.py
