# Khala stack (docker compose -f docker/docker-compose.yml)
# Copy to .env and set values. Do not commit .env with real secrets.

# ---------------------------------------------------------------------------
# Ollama Cloud (Option A: app talks to https://ollama.com)
# ---------------------------------------------------------------------------
# Create an API key at https://ollama.com/settings/keys
OLLAMA_API_KEY=

# ---------------------------------------------------------------------------
# LLM (agents)
# ---------------------------------------------------------------------------
# Provider: ollama (default), claude (alias anthropic), or dummy. Can also be set
# from the UI at /llm-config (stored encrypted; requires Postgres).
LLM_PROVIDER=ollama
# Base URL for Ollama: https://ollama.com for cloud, or http://ollama:11434 for local stack
LLM_BASE_URL=https://ollama.com
LLM_MODEL=deepseek-v4-pro:cloud
# Claude (Anthropic) provider: set LLM_PROVIDER=claude and supply a key. Default
# model when LLM_MODEL is unset is claude-opus-4-8.
# LLM_CLAUDE_API_KEY=
# ANTHROPIC_API_KEY=
# Optional: request timeout in seconds (default 3600 / 60 min). Increase if Ollama Cloud is slow.
LLM_TIMEOUT=600
# Optional: HTTP 429 rate-limit backoff. A 429 means the provider budget is
# exhausted, so retries use a dedicated schedule (first retry ~30s, doubling,
# capped) distinct from the fast 5xx/network schedule. Kept short so a
# rate-limited call fails within a few minutes instead of hanging; raise these
# for a provider that needs long waits. Defaults shown.
# LLM_RATE_LIMIT_BACKOFF_INITIAL=30
# LLM_RATE_LIMIT_BACKOFF_MAX=120
# LLM_RATE_LIMIT_MAX_RETRIES=3
# Optional: process-global cap on concurrent LLM calls (Ollama + Claude). Lower
# it if your provider plan allows few concurrent requests.
# LLM_MAX_CONCURRENCY=4
# Disable "thinking" only if the chosen Ollama Cloud model rejects the think parameter
# (qwen3.5 historically returns 500s when think is set). Safe to leave false by default.
LLM_ENABLE_THINKING=false

# ---------------------------------------------------------------------------
# Blogging team — content planning (optional)
# ---------------------------------------------------------------------------
# BLOG_PLANNING_MAX_ITERATIONS=5
# BLOG_PLANNING_MAX_PARSE_RETRIES=3
# Optional: Ollama model name for planning only (defaults to LLM_MODEL)
# BLOG_PLANNING_MODEL=

# ---------------------------------------------------------------------------
# Investment team — Strategy Lab (optional)
# ---------------------------------------------------------------------------
# Hard ceiling on the asset-class default symbol universe used when
# spec.target_symbols is empty. Defaults to 10 (covers every canonical
# universe in backend/agents/investment_team/symbols.py). When the cap
# actually truncates the universe a logger.warning fires; spec.target_symbols
# itself is never truncated. Issue #525.
# STRATEGY_LAB_MAX_UNIVERSE_SYMBOLS=10

# ---------------------------------------------------------------------------
# PostgreSQL (stack postgres; default user used for init, temporal/khala created by init script)
# ---------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# ---------------------------------------------------------------------------
# Per-team sandbox Postgres roles (issue #257)
# ---------------------------------------------------------------------------
# Set one password per currently-wired team. On first Postgres boot,
# docker/postgres/init/04-create-sandbox-team-roles.sh creates a
# sandbox_<team> role + database for each value that's set. The Agent Console
# runner writes these into each sandbox's 0400 secrets file so a sandbox for
# a blogging agent can only reach the blogging database. Leave blank to fall
# back to the global POSTGRES_* creds for that team (dev convenience).
# See docker/README.md § Per-team Postgres isolation.
POSTGRES_PASSWORD_SANDBOX_BLOGGING=
POSTGRES_PASSWORD_SANDBOX_SOFTWARE_ENGINEERING=
POSTGRES_PASSWORD_SANDBOX_PLANNING=
POSTGRES_PASSWORD_SANDBOX_BRANDING=

# ---------------------------------------------------------------------------
# Neo4j + Graphiti knowledge-graph layer (over Agent Cognition)
# ---------------------------------------------------------------------------
# Neo4j is REQUIRED stack infrastructure for agents (Graphiti runs on top of it).
# Change NEO4J_PASSWORD from the default before any non-local deployment.
#
# NEO4J_BOLT_URL is the per-process Graphiti enablement gate. The unified API
# (khala) leaves it unset by default so reverse-proxy / Agent Console deploys
# skip Graphiti client + background sync overhead. Opt in on khala only when
# that process should own graph sync (extra memory/CPU for the driver + worker):
#   NEO4J_BOLT_URL=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=please-change-me
NEO4J_DATABASE=neo4j
# Optional Neo4j memory tuning for the container (raise in production).
NEO4J_PAGECACHE_SIZE=512m
NEO4J_HEAP_SIZE=1G
# Graphiti model wiring (used when a process sets NEO4J_BOLT_URL). Leave
# GRAPHITI_LLM_MODEL blank to reuse the resolved cognition model. The embedding
# model must be available on the Ollama endpoint.
GRAPHITI_LLM_MODEL=
GRAPHITI_EMBED_MODEL=nomic-embed-text
GRAPHITI_EMBED_DIM=768

# ---------------------------------------------------------------------------
# Redis (shared.cache — SE code-review + compaction caches)
# ---------------------------------------------------------------------------
# Compose injects these only into se-service (*se-redis-env), not every team.
# Prefer HOST + PASSWORD parts (Python URL-encodes the password). Unset REDIS_URL
# and keep REDIS_HOST=redis for the stack Redis. For in-process LRU on SE, set
# REDIS_HOST= (empty) and leave REDIS_URL blank — compose preserves empty HOST
# via ${REDIS_HOST-redis} (not :-).
# Change REDIS_PASSWORD from the default before any non-local deployment.
REDIS_PASSWORD=please-change-me
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# Leave REDIS_URL unset/blank so the client builds a quoted URL from the parts above.
# REDIS_URL=
# Or override with an already-encoded URL: REDIS_URL=redis://:please-change-me@redis:6379/0
# REDIS_CACHE_TTL_S=3600
# REDIS_LOCK_TTL_S=3600
# REDIS_WAITER_TIMEOUT_S=300
# REDIS_SOCKET_CONNECT_TIMEOUT_S=1.0
# REDIS_SOCKET_TIMEOUT_S=1.0
# REDIS_MAX_CONNECTIONS=50
# Optional: append to cr:*/llm:compact:* namespaces so a deploy is a cold cache.
# Safe token only ([A-Za-z0-9._@+/-]+). KHALA_CACHE_BUILD_ID wins if both set.
# KHALA_BUILD_ID=
# KHALA_CACHE_BUILD_ID=

# ---------------------------------------------------------------------------
# Temporal (uses temporal/temporal database and user created by init script)
# ---------------------------------------------------------------------------
# No extra vars needed; service uses POSTGRES_SEEDS=postgres, POSTGRES_USER=temporal, POSTGRES_PWD=temporal
# For khala (unified API): connect to Temporal for SE team workflows
TEMPORAL_ADDRESS=temporal:7233
# Optional: namespace (default "default"), task queue (default "software-engineering")
# TEMPORAL_NAMESPACE=default
# TEMPORAL_TASK_QUEUE=software-engineering
# Optional: compress large Temporal payloads (e.g. the code review agent's
# map-reduce chunks) so they stay under Temporal's 512 KiB PayloadSizeWarning.
# Left off by default: every team's service in this stack is an independently
# restartable container sharing this one Temporal instance, and a container
# built before this codec existed can never decode a payload one that already
# has it wrote. Enable only after confirming every service container here is
# running a build with backend/agents/shared_temporal/codec.py — see
# docs/ENV_VARS.md.
# TEMPORAL_PAYLOAD_COMPRESSION=true

# ---------------------------------------------------------------------------
# Job Service (centralized job management)
# ---------------------------------------------------------------------------
# URL for the job service container. Teams use this to persist job state.
JOB_SERVICE_URL=http://job-service:8085

# ---------------------------------------------------------------------------
# Unified API — team proxy URLs (optional overrides; full stack sets these in docker-compose.yml)
# ---------------------------------------------------------------------------
# If you run the unified API outside Docker, point each team at a running service, e.g.:
# AGENTIC_TEAM_PROVISIONING_SERVICE_URL=http://localhost:8108

# ---------------------------------------------------------------------------
# Logs API (testing only)
# ---------------------------------------------------------------------------
# Set to 1 to enable GET /api/software-engineering/logs (returns supervisor log content)
ENABLE_LOG_API=0

# ---------------------------------------------------------------------------
# Unified API — team-assistant sub-app mounts
# ---------------------------------------------------------------------------
# Each team's assistant sub-app is registered at startup but only actually
# constructed and mounted lazily, on that team's first matching request. Set
# to false to skip registration entirely (zero assistant mounts, regardless
# of traffic). Team proxy routes and health checks are unaffected either way.
# See docs/ENV_VARS.md.
UNIFIED_API_TEAM_ASSISTANTS_ENABLED=true

# ---------------------------------------------------------------------------
# Optional: spec file for agents build
# ---------------------------------------------------------------------------
# SPEC_FILE=agents/docker/default_initial_spec.md

# ---------------------------------------------------------------------------
# SE team project workspaces (created via file upload)
# ---------------------------------------------------------------------------
# Base directory where SE team project workspaces are created via file upload.
# Falls back to ENV_WORKSPACE_ROOT if set, then ./se_workspaces relative to CWD.
# SE_WORKSPACE_DIR=/path/to/workspaces

# ---------------------------------------------------------------------------
# Observability (Prometheus + Grafana)
# ---------------------------------------------------------------------------
# Grafana admin credentials. NOTE: only read on first boot (when the
# grafana_data volume is empty). Changing these later has no effect — reset
# via the Grafana UI or remove the grafana_data volume.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Prometheus on-disk retention window. Accepts s/m/h/d/w/y suffixes.
PROMETHEUS_RETENTION=15d

# OpenTelemetry tracing. Only se-service, investment-service, and branding-service
# export OTLP traces to the in-stack Grafana Tempo (view in Grafana → Explore →
# Tempo). Other containers leave OTEL_EXPORTER_OTLP_ENDPOINT unset so spans stay
# in-process. Point OTEL_EXPORTER_OTLP_ENDPOINT at an external collector to use
# your own. Metrics stay on Prometheus scraping, so OTLP metric export is disabled
# (OTEL_METRICS_EXPORTER=none) to avoid pushing metrics at the traces-only backend.
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_METRICS_EXPORTER=none
# Head sampling (SDK-honored). parentbased_traceidratio keeps parent decisions
# and samples root traces at OTEL_TRACES_SAMPLER_ARG (default 5%).
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.05
# Bound attribute value length/count so large LLM prompt/response attributes
# don't push spans past Tempo's max_bytes_per_trace ingest cap and get refused.
OTEL_ATTRIBUTE_VALUE_LENGTH_LIMIT=2048
OTEL_SPAN_ATTRIBUTE_COUNT_LIMIT=64
# Span export hardening: fail fast and bound the in-process span buffer so a slow
# Tempo can't accumulate spans inside a memory-constrained worker.
# OTEL_EXPORTER_OTLP_TIMEOUT is in seconds; OTEL_BSP_SCHEDULE_DELAY is in milliseconds.
OTEL_EXPORTER_OTLP_TIMEOUT=5
OTEL_BSP_MAX_QUEUE_SIZE=512
OTEL_BSP_MAX_EXPORT_BATCH_SIZE=128
OTEL_BSP_SCHEDULE_DELAY=2000  # milliseconds (2s)

# ---------------------------------------------------------------------------
# Process health & memory footprint (Docker VM is memory-constrained)
# ---------------------------------------------------------------------------
# uvicorn workers per team service. Each is a full interpreter; 1 keeps the
# per-team footprint small on a shared VM. Raise for throughput once you have RAM.
TEAM_WORKERS=1
# Memory watchdog sample cadence (s). Also polls the cgroup oom_kill counter, so a
# shorter interval surfaces a silent OOM kill sooner.
TEAM_MEMORY_WATCHDOG_INTERVAL_S=10
# Investment team: max concurrent Strategy Lab cycles per wave (each holds market
# data + LLM contexts in one worker). Bounds peak memory; raise with more RAM.
STRATEGY_LAB_MAX_CONCURRENT_CYCLES=2
